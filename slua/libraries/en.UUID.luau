local UUID = {}

--- Determines if a string is a valid UUID (including NULL_KEY).
-- @param input Any string.
-- @result true if valid, false if invalid.
function UUID.Is(input: string)
    local uuid = touuid(input)
    if uuid == nil then
        return false
    elseif not uuid.istruthy then
        -- input is either "", NULL_KEY, or some other non-UUID string
        if input == NULL_KEY then
            return true
        end
        return false
    end
    return true
end

--- Determines if a string is NULL_KEY.
-- This generally shouldn't be used ever; it is provided for LSL macro cross-compatibility.
-- @param input Any string.
-- @result true if NULL_KEY, false otherwise.
function UUID.IsNull(input: string)
    return input == NULL_KEY
end

--- Determines if a string is a valid UUID (excluding NULL_KEY).
-- SLua supports this natively with .istruthy; consider using that instead.
-- @param input Any string.
-- @result true if valid, false if invalid.
function UUID.IsNotNull(input: string)
    local uuid = touuid(input)
    return uuid.istruthy
end

--- Determines if a string is a valid UUID that exists in this region.
-- @param input Any string.
-- @result true if it exists, false otherwise.
function UUID.IsInRegion(input: string)
    if UUID.IsAvatarInRegion(input) then
        return true
    end
    return UUID.IsPrimInRegion(input)
end

--- Determines if a string is a valid UUID of an avatar that exists in this region.
-- @param input Any string.
-- @result true if it is an avatar in this region, false otherwise.
function UUID.IsAvatarInRegion(input: string)
    local uuid = touuid(input)
    if uuid == nil then
        return false
    end
    if ll.GetAgentSize(uuid) == ZERO_VECTOR then
        return false
    end
    return true
end

--- Determines if a string is a valid UUID of a prim that exists in this region.
-- @param input Any string.
-- @result true if it is a prim in this region, false otherwise.
function UUID.IsPrimInRegion(input: string)
    local uuid = touuid(input)
    if uuid == nil then
        -- uuid is invalid
        return false
    end
    local details = ll.GetObjectDetails(uuid, {OBJECT_OWNER})
    if #details == 0 then
        -- uuid doesn't exist in this region
        return false
    end
    if tostring(details[1]) == string.lower(input) then
        -- uuid points to an avatar (owner matches uuid)
        return false
    end
    return true
end

--- Strips dashes out of a UUID, if and only if it is a valid UUID.
-- @param input Any string.
-- @result input with all dashes removed.
function UUID.Strip(input: string)
    if not UUID.Is(input) then
        return input
    end
    return ll.ReplaceSubString(input, "-", "", 0)
end

--- Adds dashes into a 32-character string to turn it back into a key.
-- @param input Any string (ideally one generated by UUID.Strip()).
-- @result A UUID or, if the input is not a stripped UUID, the unmodified input.
function UUID.Unstrip(input: string)
    if #input ~= 32 then
        -- note that # on strings returns their byte count, not length, but that doesn't matter here
        return input
    end
    local unstripped = string.sub(input, 1, 8)
             .. "-" .. string.sub(input, 9, 12)
             .. "-" .. string.sub(input, 13, 16)
             .. "-" .. string.sub(input, 17, 20)
             .. "-" .. string.sub(input, 21, 32)
    if not UUID.Is(unstripped) then
        return input
    end
    return unstripped
end

--- Strips dashes out of a key and encodes it in Base64 (36 characters down to 24).
-- Note that SLua supports null bytes and LSL does not; if you only expect to use this value in SLua, consider passing a uuid to uuid.bytes, which converts the UUID into a raw binary string.
-- This function is provided to support mixed-language uses and for compatibility with the LSL enUUID_Compress() function.
-- @param input Any string.
-- @result The compressed UUID.
function UUID.Compress(input: string)
    if not UUID.Is(input) then
        return input
    end
    -- concatenate the first 6 characters of Base64 encoding of each 8 nybbles (the remaining chars returned by ll.IntegerToBase64() is always padding)
    return string.sub(ll.IntegerToBase64(tonumber(string.sub(input, 1, 8), 16) or 0), 1, 6)
        .. string.sub(ll.IntegerToBase64(tonumber(string.sub(input, 9, 16), 16) or 0), 1, 6)
        .. string.sub(ll.IntegerToBase64(tonumber(string.sub(input, 17, 24), 16) or 0), 1, 6)
        .. string.sub(ll.IntegerToBase64(tonumber(string.sub(input, 25, 32), 16) or 0), 1, 6)
end

--- Reverses UUID.Compress().
-- @param input Any string that was generated with UUID.Compress().
-- @result The original UUID (as a string).
function UUID.Decompress(input: string)
    if #input ~= 24 then
        return input
    end
    -- we presume this is a valid compressed uuid at this point
    -- convert from Base64 to a 32-nybble hex string
    local hex = string.format("%08x", ll.Base64ToInteger(string.sub(input, 1, 6)))
             .. string.format("%08x", ll.Base64ToInteger(string.sub(input, 7, 12)))
             .. string.format("%08x", ll.Base64ToInteger(string.sub(input, 13, 18)))
             .. string.format("%08x", ll.Base64ToInteger(string.sub(input, 19, 24)))
    return UUID.Unstrip(hex)
end

return UUID
